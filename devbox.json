{
  "name": "project-lint",
  "version": "0.1.0",
  "description": "A CLI tool for project linting and file organization",
  "packages": {
    "rustc": "",
    "cargo": "",
    "rust-analyzer": "",
    "clippy": "",
    "rustfmt": "",
    "just": "",
    "universal-ctags": "",
    "git": "",
    "pkg-config": "",
    "openssl": "",
    "libgit2": "",
    "zlib": "",
    "github:levonk/levonk-packages#devbox-rtk-nodejs-pnpm-force": "",
    "github:levonk/levonk-packages#devbox-rtk-python-uv-force": "",
    "github:levonk/levonk-packages#bundle-rtk-core": "",
    "github:levonk/levonk-packages#bundle-rtk-cloud": "",
    "github:levonk/smartfo": "",
    "clang": "",
    "git-secrets": "",
    "git-imerge": ""
  },
  "shell": {
    "init_hook": [
      "just bootstrap_impl"
    ]
  },
  "scripts": {
    "bootstrap": "just bootstrap_impl",
    "doctor": "just doctor_impl",
    "clean": "just clean_impl",
    "build": "just build_impl",
    "lint": "just lint_impl",
    "test": "just test_impl",
    "typecheck": "just typecheck_impl",
    "dev": "just dev_impl",
    "debug": "just debug_impl",
    "install": "just install_impl",
    "release": "just release_impl"
  },
  "env": {
    "RUST_LOG": "debug",
    "RUST_BACKTRACE": "1"
  }
}
